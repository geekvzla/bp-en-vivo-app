<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de cada ítem de la guía: el foco del D-pad se ve con borde naranja
     grueso y fondo aclarado; al pulsar (táctil) se marca con el mismo acento. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF263069" />
            <stroke
                android:width="3dp"
                android:color="#FFFF6B35" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF263069" />
            <stroke
                android:width="2dp"
                android:color="#FFFF6B35" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
